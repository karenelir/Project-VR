<?xml version="1.0" encoding="UTF-8" ?><ChoregrapheProject xmlns="http://www.aldebaran-robotics.com/schema/choregraphe/project.xsd" xar_version="3"><Box name="root" id="-1" localization="8" tooltip="Root box of Choregraphe&apos;s behavior. Highest level possible." x="0" y="0"><bitmap>media/images/box/root.png</bitmap><script language="4"><content><![CDATA[]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /><Timeline enable="0"><BehaviorLayer name="behavior_layer1"><BehaviorKeyframe name="keyframe1" index="1"><Diagram scale="100"><Box name="Close Session (step 1)" id="1" localization="8" tooltip="Reusable 'Say with Tablet' box: stand up, closing.html, Pepper closes the session." x="40" y="60"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import time
try:
    from urllib import quote, unquote
except ImportError:
    from urllib.parse import quote, unquote

class MyClass(GeneratedClass):
    # Reusable "Say with Tablet" box: (optionally stand up first,) show a page on the tablet, then say the text
    # with body language. onStopped when Pepper has finished talking.

    def __init__(self):
        GeneratedClass.__init__(self, False)

    def onLoad(self):
        pass

    def onUnload(self):
        try:
            ALProxy("ALTextToSpeech").stopAll()
        except Exception:
            pass

    def onInput_onStart(self):
        if self.getParameter("Stand up first"):
            try:
                posture = ALProxy("ALRobotPosture")
                posture.setMaxTryNumber(3)
                posture.goToPosture("Stand", 0.8)
            except Exception as e:
                self.logger.warning("Posture not available: " + str(e))
            try:
                ALProxy("ALLeds").fadeRGB("FaceLeds", 0xFFFFFF, 0.3)
            except Exception:
                pass
        parts = []
        for pair in str(self.getParameter("Query")).split("&"):
            if "=" in pair:
                k, v = pair.split("=", 1)
                parts.append(k + "=" + quote(unquote(v), safe=""))
        parts.append("t=%d" % int(time.time()))
        try:
            self.session().service("ALTabletService").showWebview(
                "http://198.18.0.1/apps/%s/pages/%s?%s" % (self.packageUid(), self.getParameter("Page"), "&".join(parts)))
        except Exception as e:
            self.logger.warning("Tablet error: " + str(e))
        try:
            ALProxy("ALAnimatedSpeech").say(str(self.getParameter("Text")), {"bodyLanguageMode": "contextual"})
        except Exception as e:
            self.logger.error("Speech: " + str(e))
        self.onStopped()

    def onInput_onStop(self):
        self.onUnload()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="" id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" /><Parameter name="Page" inherits_from_parent="0" content_type="3" value="closing.html" default_value="closing.html" custom_choice="0" tooltip="Page in html/pages/." id="5" /><Parameter name="Query" inherits_from_parent="0" content_type="3" value="" default_value="" custom_choice="0" tooltip="URL parameters for the page." id="6" /><Parameter name="Text" inherits_from_parent="0" content_type="3" value="Welcome back, brave warriors! \pau=500\ You all made it out alive, and my arena is still in one piece. \pau=500\ Impressive! \pau=500\ Your game session is now officially closed. \pau=500\ Let me check how you did. \pau=500\ Drum roll, please!" default_value="Welcome back, brave warriors! \pau=500\ You all made it out alive, and my arena is still in one piece. \pau=500\ Impressive! \pau=500\ Your game session is now officially closed. \pau=500\ Let me check how you did. \pau=500\ Drum roll, please!" custom_choice="0" tooltip="What Pepper says (\pau=500\ = half-second pause)." id="7" /><Parameter name="Stand up first" inherits_from_parent="0" content_type="0" value="1" default_value="1" tooltip="Go to the Stand posture (and neutral eyes) before talking." id="8" /></Box><Box name="Get Game Result" id="4" localization="8" tooltip="UC05 - gets the game result: score server on the venue PC (/api/scores), then ALMemory, simulated, or manual staff input." x="240" y="60"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[import json, time
try:
    import urllib2
    from urllib import quote
except ImportError:
    import urllib.request as urllib2
    from urllib.parse import quote

def _txt(value):
    # Pepper runs Python 2.7: JSON gives unicode, and str() of a name like "Zoé" or "Élie" would crash
    if value is None:
        return ""
    try:
        if isinstance(value, unicode):
            return value.encode("utf-8")
    except NameError:
        pass
    return str(value)

class MyClass(GeneratedClass):
    # UC05 - Get the game result (PRECOND-2).
    # Result sent on resultAvailable:  outcome|game|score|team|playersJson
    #     outcome = win | lose | tie | played,  playersJson = [{"name": "...", "score": "..."}, ...]
    # Order of the sources:
    #   1. The venue PC score server (app.py, GET /api/scores), "Server URL" + optional "Session ID".
    #   2. ALMemory key "Memory key" (outcome|game|score|team), if another program writes it.
    #   3. "Simulated result" (prototype / testing without the PC). "off" = not used.
    #   4. Manual staff input on the tablet (staffresult.html), if "Use staff input" is checked.
    # -> resultAvailable(result)  or  resultMissing()  (extension 2a)

    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        self.waiting = False
        self.staffAnswer = None
        self.links = []

    def onUnload(self):
        self.waiting = False
        self._disconnect()

    def _service(self, name):
        try:
            return self.session().service(name)
        except Exception as e:
            self.logger.warning("%s not available: %s" % (name, str(e)))
            return None

    def _isValid(self, result):
        try:
            outcome = str(result).split("|")[0].strip().lower()
        except Exception:
            return False
        return outcome in ("win", "lose", "tie", "played")

    def _clean(self, text):
        # "|" separates the fields of the result, so it can never appear inside a field
        return " ".join(_txt(text).replace("|", "/").split())

    # ---- 1. venue PC score server --------------------------------------------------------------
    def _fromServer(self):
        base = str(self.getParameter("Server URL")).strip().rstrip("?")
        if not base or base.lower() == "off":
            return None
        session_id = str(self.getParameter("Session ID")).strip()
        url = base
        if session_id:
            url += ("&" if "?" in base else "?") + "session_id=" + quote(session_id, safe="")
        try:
            timeout = float(self.getParameter("Server timeout (s)"))
        except Exception:
            timeout = 5.0
        try:
            response = urllib2.urlopen(url, timeout=timeout)
            payload = json.loads(response.read())
        except urllib2.HTTPError as e:
            detail = ""
            try:
                detail = e.read()[:300]
            except Exception:
                pass
            self.logger.warning("Score server %s answered HTTP %s %s" % (url, e.code, _txt(detail)))
            return None
        except Exception as e:
            self.logger.warning("Score server %s not reachable: %s" % (url, str(e)))
            return None
        if not isinstance(payload, dict):
            self.logger.warning("Score server: unexpected answer")
            return None
        players = []
        for p in payload.get("players") or []:
            if isinstance(p, dict):
                name = self._clean(p.get("name") or p.get("player_name") or "Player")
                score = self._clean(p.get("score"))
                players.append({"name": name or "Player", "score": score or "0"})
        if not players:
            self.logger.warning("Score server: no player scores for this session")
            return None
        outcome = str(payload.get("outcome") or "played").strip().lower()
        if outcome not in ("win", "lose", "tie", "played"):
            outcome = "played"
        players_json = json.dumps(players, ensure_ascii=True, separators=(",", ":"))
        self.logger.info("Loaded %d player scores from the score server (session %s)" % (len(players), _txt(payload.get("session_id", "latest"))))
        return "|".join((outcome, self._clean(payload.get("game")), self._clean(payload.get("score")),
                         self._clean(payload.get("team")), players_json))

    # ---- 4. staff input ------------------------------------------------------------------------
    def _onStaffResult(self, value):
        self.staffAnswer = str(value)

    def _onStaffSkip(self, value):
        self.staffAnswer = "none"

    def _disconnect(self):
        for (sub, link) in self.links:
            try:
                sub.signal.disconnect(link)
            except Exception:
                pass
        self.links = []

    def _askStaff(self, memory):
        tablet = self._service("ALTabletService")
        if not tablet or not memory:
            return None
        self.staffAnswer = None
        try:
            for (event, cb) in (("staffResult", self._onStaffResult), ("staffSkip", self._onStaffSkip)):
                sub = memory.subscriber(event)
                self.links.append((sub, sub.signal.connect(cb)))
        except Exception as e:
            self.logger.warning("Cannot subscribe to staff events: " + str(e))
            return None
        url = "http://198.18.0.1/apps/%s/pages/staffresult.html?t=%d" % (self.packageUid(), int(time.time()))
        try:
            tablet.showWebview(url)
        except Exception as e:
            self.logger.warning(str(e))
        try:
            ALProxy("ALTextToSpeech").say("Hmm, I could not get your scores from the score computer. A staff member will enter your result on my tablet.")
        except Exception:
            pass
        self.waiting = True
        deadline = time.time() + int(self.getParameter("Staff timeout (s)"))
        while self.waiting and self.staffAnswer is None and time.time() < deadline:
            time.sleep(0.2)
        self.waiting = False
        self._disconnect()
        return self.staffAnswer

    # ---- main ----------------------------------------------------------------------------------
    def onInput_onStart(self):
        # 1. venue PC score server
        result = self._fromServer()
        if result:
            self.resultAvailable(result)
            return

        # 2. ALMemory (another program can write outcome|game|score|team there)
        memory = self._service("ALMemory")
        key = self.getParameter("Memory key")
        result = ""
        if memory:
            try:
                result = str(memory.getData(key))
            except Exception:
                result = ""
        if self._isValid(result):
            try:
                memory.insertData(key, "")     # consume it so the next group is not celebrated with it
            except Exception:
                pass
            self.logger.info("Result from ALMemory: " + result)
            self.resultAvailable(result)
            return

        # 3. simulated (testing without the PC)
        sim = str(self.getParameter("Simulated result")).strip()
        if sim.lower() == "none":
            self.logger.info("Simulated: no result available (extension 2a)")
            self.resultMissing()
            return
        if self._isValid(sim):
            self.logger.info("Simulated result: " + sim)
            self.resultAvailable(sim)
            return

        # 4. manual staff input
        if self.getParameter("Use staff input"):
            answer = self._askStaff(memory)
            if answer and self._isValid(answer):
                self.logger.info("Result from staff: " + answer)
                self.resultAvailable(answer)
                return

        self.logger.info("No game result available (extension 2a)")
        self.resultMissing()

    def onInput_onStop(self):
        self.waiting = False
]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="" id="3" /><Output name="resultAvailable" type="3" type_size="1" nature="2" inner="0" tooltip="" id="4" /><Output name="resultMissing" type="1" type_size="1" nature="2" inner="0" tooltip="" id="5" /><Parameter name="Server URL" inherits_from_parent="0" content_type="3" value="http://10.10.42.225:5000/api/scores" default_value="http://10.10.42.225:5000/api/scores" custom_choice="0" tooltip="Score server on the venue PC (app.py, /api/scores). Put the IP of the laptop running app.py. Empty or off = not used." id="6" /><Parameter name="Session ID" inherits_from_parent="0" content_type="3" value="" default_value="" custom_choice="0" tooltip="Optional. Empty = the latest session in scores.csv." id="7" /><Parameter name="Server timeout (s)" inherits_from_parent="0" content_type="1" value="5" default_value="5" min="1" max="30" tooltip="How long to wait for the score server before using the next source." id="8" /><Parameter name="Memory key" inherits_from_parent="0" content_type="3" value="UC05/GameResult" default_value="UC05/GameResult" custom_choice="0" tooltip="ALMemory key written by the venue system: outcome|game|score|team" id="9" /><Parameter name="Simulated result" inherits_from_parent="0" content_type="3" value="off" default_value="off" custom_choice="1" tooltip="Testing only, used when the score server gives nothing. outcome|game|score|team. none = no result (extension 2a). off = go to staff input." id="10"><Choice value="off" /><Choice value="win|Outbreak|8200|" /><Choice value="lose|Far Cry|1450|" /><Choice value="tie|Space Marines|5000|" /><Choice value="none" /></Parameter><Parameter name="Use staff input" inherits_from_parent="0" content_type="0" value="1" default_value="1" tooltip="Show staffresult.html on the tablet when no result is available." id="11" /><Parameter name="Staff timeout (s)" inherits_from_parent="0" content_type="1" value="60" default_value="60" min="5" max="600" tooltip="How long to wait for staff input before continuing without a result." id="12" /></Box><Box name="Celebrate Result (step 2)" id="5" localization="8" tooltip="UC05 step 2: result page, victory dance, personalized reaction. onNoResult = extension 2a." x="440" y="60"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import json, os, random, time
import re as _re
_BS = chr(92)
def _pauses(text):
    # UC05: half-second pause after every sentence that does not already have one, so long lines are easier to follow
    text = _re.sub(r"([.!?])\s+" + _re.escape(_BS) + r"pau=[1-4]\d\d" + _re.escape(_BS),
                   lambda m: m.group(1) + " " + _BS + "pau=500" + _BS, text)
    return _re.sub(r"([.!?])\s+(?!" + _re.escape(_BS) + r"pau)(?=[A-Z^])",
                   lambda m: m.group(1) + " " + _BS + "pau=500" + _BS + " ", text)
try:
    from urllib import quote
except ImportError:
    from urllib.parse import quote

DANCE = {
    'HeadPitch': ([0.68, 0.88, 1.12, 1.32, 1.56, 1.76, 2.0, 2.2, 2.44, 2.64, 2.88, 3.08, 3.32, 3.52, 3.76, 3.96, 4.2, 4.4, 4.84, 5.04, 5.28, 5.52, 5.72, 5.96, 6.16, 6.4, 6.6, 6.84, 7.04, 7.24, 7.28, 7.48, 7.72, 7.92, 8.16, 8.36, 8.6, 8.8, 9.04, 9.24, 9.48, 9.68, 9.92, 10.12, 10.36, 10.56],
            [-0.383, -0.232, -0.383, -0.15, -0.383, -0.232, -0.383, -0.15, -0.383, -0.232, -0.383, -0.15, -0.383, -0.232, -0.383, -0.161, -0.383, -0.169, -0.382, -0.37, -0.143, -0.382, -0.143, -0.382, -0.143, -0.382, -0.143, -0.382, -0.143, -0.382, -0.382, -0.145, -0.382, -0.145, -0.382, -0.145, -0.382, -0.145, -0.382, -0.145, -0.382, -0.145, -0.382, -0.145, -0.382, -0.145]),
    'HeadYaw': ([0.68, 1.12, 1.56, 2.0, 2.44, 2.88, 3.32, 3.76, 4.2, 5.0, 5.52, 5.96, 6.4, 6.84, 7.28, 7.72, 8.16, 8.6, 9.04, 9.48],
            [-0.402, 0.402, -0.402, 0.402, -0.402, 0.402, -0.402, 0.402, -0.367, -0.408, 0.402, -0.402, 0.402, -0.402, 0.402, -0.402, 0.402, -0.402, 0.402, -0.402]),
    'HipPitch': ([0.68, 0.88, 1.12, 1.32, 1.56, 1.76, 2.0, 2.2, 2.44, 2.64, 2.88, 3.08, 3.32, 3.52, 3.76, 3.96, 4.2, 4.4, 4.84, 5.08, 5.28, 5.52, 5.72, 5.96, 6.16, 6.4, 6.6, 6.84, 7.04, 7.28, 7.48, 7.72, 7.92, 8.16, 8.36, 8.6, 8.8, 9.04, 10.36],
            [-0.062, -0.137, -0.062, -0.137, -0.062, -0.137, -0.062, -0.137, -0.062, -0.137, -0.062, -0.137, -0.062, -0.137, -0.062, -0.137, -0.062, -0.133, -0.049, -0.049, -0.125, -0.048, -0.124, -0.049, -0.125, -0.048, -0.124, -0.049, -0.125, -0.048, -0.124, -0.049, -0.125, -0.048, -0.124, -0.049, -0.125, -0.048, -0.992]),
    'HipRoll': ([0.68, 0.88, 1.12, 1.32, 1.56, 1.76, 2.0, 2.2, 2.44, 2.64, 2.88, 3.08, 3.32, 3.52, 3.76, 3.96, 4.2, 4.4, 4.84, 5.08, 5.28, 5.52, 5.72, 5.96, 6.16, 6.4, 6.6, 6.84, 7.04, 7.28, 7.48, 7.72, 7.92, 8.16, 8.36, 8.6, 8.8, 9.04, 10.36],
            [-0.07, -0.01, 0.07, 0.017, -0.07, -0.01, 0.07, 0.019, -0.067, -0.008, 0.07, 0.017, -0.071, -0.01, 0.07, 0.01, -0.07, -0.07, -0.07, -0.07, -0.01, 0.07, 0.01, -0.07, -0.015, 0.056, 0.002, -0.07, -0.015, 0.056, 0.002, -0.07, -0.013, 0.062, 0.009, -0.061, -0.011, 0.071, 0.058]),
    'KneePitch': ([0.68, 0.88, 1.12, 1.32, 1.56, 1.76, 2.0, 2.2, 2.44, 2.64, 2.88, 3.08, 3.32, 3.52, 3.76, 3.96, 4.2, 4.4, 4.84, 5.08, 5.28, 5.52, 5.72, 5.96, 6.16, 6.4, 6.6, 6.84, 7.04, 7.28, 7.48, 7.72, 7.92, 8.16, 8.36, 8.6, 8.8, 9.04, 10.36],
            [-0.05, -0.004, -0.05, -0.004, -0.05, -0.004, -0.05, -0.004, -0.05, -0.004, -0.05, -0.004, -0.05, -0.004, -0.05, -0.004, -0.05, 0.004, -0.022, -0.022, 0.024, -0.019, 0.024, -0.022, 0.024, -0.019, 0.024, -0.022, 0.024, -0.019, 0.024, -0.022, 0.024, -0.019, 0.024, -0.022, 0.024, -0.019, 0.399]),
    'LElbowRoll': ([0.72, 0.96, 1.16, 1.36, 1.6, 1.8, 2.0, 2.24, 2.44, 2.68, 2.88, 3.12, 3.32, 3.56, 3.76, 4.0, 4.2, 4.88, 5.08, 5.52, 5.96, 6.4, 6.84, 7.28, 7.72, 8.16, 8.6, 9.04, 9.48, 9.92, 10.36],
            [-0.356, -0.806, -1.256, -0.944, -0.356, -0.614, -1.256, -0.874, -0.356, -0.737, -1.256, -0.82, -0.356, -0.696, -1.203, -0.888, -0.403, -1.332, -1.361, -1.136, -1.361, -1.142, -1.361, -1.136, -1.361, -1.172, -1.361, -1.136, -1.361, -1.136, -1.361]),
