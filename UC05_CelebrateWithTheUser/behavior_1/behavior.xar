            [-1.054, -0.801, -1.054, -0.801, -1.054, -0.801, -1.054, -0.801, -1.346]),
    'LHand': ([0.8, 0.96, 1.24, 1.4, 1.68, 1.8, 2.08, 2.24, 2.52, 2.68, 2.96, 3.12, 3.4, 3.56, 3.84, 4.0, 4.28, 4.84, 5.08, 5.52, 5.96, 6.4, 6.84, 7.28, 7.72, 8.16, 8.6, 9.04, 9.48, 9.92, 10.36],
            [0.91, 0.5, 1.0, 0.47, 1.0, 0.35, 1.0, 0.53, 1.0, 0.45, 1.0, 0.48, 1.0, 0.5, 1.0, 0.58, 0.779, 0.0, 0.0, 0.73, 0.0, 0.73, 0.0, 0.73, 0.0, 0.73, 0.0, 0.73, 0.0, 0.73, 0.0]),
    'LShoulderPitch': ([0.68, 1.12, 1.56, 2.0, 2.44, 2.88, 3.32, 3.76, 4.2, 4.84, 5.08, 5.52, 5.96, 6.4, 6.84, 7.28, 7.72, 8.16, 8.6, 9.04, 9.48, 9.92, 10.36],
            [-1.003, -1.063, -1.003, -1.063, -1.003, -1.063, -1.003, -1.063, -1.003, -0.016, -0.016, 0.435, -0.016, 0.435, -0.016, 0.435, -0.016, 0.435, -0.016, 0.435, -0.016, 0.435, -0.016]),
    'LShoulderRoll': ([0.68, 1.12, 1.56, 2.0, 2.44, 2.88, 3.32, 3.76, 4.2, 4.84, 5.08],
            [0.838, 0.669, 0.838, 0.669, 0.838, 0.669, 0.838, 0.669, 0.838, 0.2, 0.187]),
    'LWristYaw': ([0.76, 0.96, 1.2, 1.36, 1.64, 1.8, 2.04, 2.24, 2.48, 2.68, 2.92, 3.12, 3.36, 3.56, 3.8, 4.0, 4.24, 4.84, 5.04, 5.52, 5.96, 6.4, 6.84, 7.28, 7.72, 8.16, 8.6, 9.04, 9.48, 9.92, 10.36],
            [0.259, 0.051, 0.698, 0.63, 0.259, 0.154, 0.523, 0.63, 0.259, 0.255, 0.523, 0.494, 0.259, 0.187, 0.523, 0.562, 0.086, -0.325, -0.283, 0.517, -0.325, 0.562, -0.325, 0.562, -0.325, 0.562, -0.325, 0.562, -0.325, 0.562, -0.325]),
    'RElbowRoll': ([0.72, 0.96, 1.2, 1.36, 1.6, 1.8, 2.0, 2.24, 2.44, 2.68, 2.88, 3.12, 3.32, 3.56, 3.76, 4.0, 4.28, 4.76, 5.08, 5.52, 5.96, 6.4, 6.84, 7.28, 7.72, 8.16, 8.6, 9.04, 9.48, 9.92, 10.36],
            [1.256, 0.871, 0.356, 0.646, 1.256, 0.925, 0.356, 0.726, 1.256, 0.859, 0.405, 0.738, 1.256, 0.792, 0.415, 0.7, 1.253, 1.358, 1.136, 1.361, 1.136, 1.361, 1.136, 1.361, 1.136, 1.361, 1.136, 1.361, 1.136, 1.361, 1.136]),
