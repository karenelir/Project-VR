    'RShoulderPitch': ([0.68, 1.12, 1.56, 2.0, 2.44, 2.88, 3.32, 3.76, 4.2, 4.88, 5.08, 5.52, 5.96, 6.4, 6.84, 7.28, 7.72, 8.16, 8.6, 9.04, 9.48, 9.92, 10.36],
            [-1.063, -1.003, -1.063, -1.003, -1.063, -1.003, -1.063, -1.003, -1.063, 0.735, 0.764, -0.016, 0.764, -0.016, 0.764, -0.016, 0.764, -0.016, 0.764, -0.016, 0.764, -0.016, 0.764]),
