class MyClass(GeneratedClass):
    """UC05 - store the rating (and the improvement idea after a low rating).
    ALMemory: UC05/LastRating, UC05/LastFeedback.
    File: ~/uc05_ratings.csv on the robot  (timestamp,game,type,value)."""

    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def _memory(self):
        try:
            return self.session().service("ALMemory")
        except Exception:
            return None

    def _append(self, kind, value):
        mem = self._memory()
        game = ""
        try:
            game = str(mem.getData("UC05/LastGame"))
        except Exception:
            pass
        line = "%s,%s,%s,%s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"),
                                  game.replace(",", " "), kind, str(value).replace(",", " "))
        try:
            path = os.path.expanduser("~/uc05_ratings.csv")
            new = not os.path.exists(path)
            f = open(path, "a")
            if new:
                f.write("timestamp,game,type,value\n")
            f.write(line)
            f.close()
        except Exception as e:
            self.logger.warning("Could not write rating file: " + str(e))
        self.logger.info("UC05 %s: %s" % (kind, value))

    def onInput_onRating(self, rating):
        mem = self._memory()
        try:
            mem.insertData("UC05/LastRating", int(rating))
        except Exception:
            pass
        self._append("rating", rating)
        self.onStopped()

    def onInput_onFeedback(self, feedback):
        mem = self._memory()
        try:
            mem.insertData("UC05/LastFeedback", str(feedback))
        except Exception:
            pass
        self._append("feedback", feedback)
        self.onStopped()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onRating" type="2" type_size="1" nature="1" inner="0" tooltip="" id="2" /><Input name="onFeedback" type="3" type_size="1" nature="1" inner="0" tooltip="" id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" /></Box><Box name="Farewell (step 7)" id="17" localization="8" tooltip="Say some text with animations. The text can be localized." x="1930" y="40"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import time

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self, False)
        self.tts = ALProxy('ALAnimatedSpeech')
        self.ttsStop = ALProxy('ALAnimatedSpeech', True) #Create another proxy as wait is blocking if audioout is remote

    def onLoad(self):
        self.bIsRunning = False
        self.ids = []

    def onUnload(self):
        for id in self.ids:
            try:
                self.ttsStop.stop(id)
            except:
                pass
        while( self.bIsRunning ):
            time.sleep( 0.2 )

    def onInput_onStart(self):
        self.bIsRunning = True
        try:
            movement = self.getParameter("Speaking movement mode")
            textParam = self.getParameter("Text")
            if movement == "disabled":
                textParam = "^start({0}) {1} ^wait({0})".format(self.getParameter("Animation"), textParam)
            sentence = "\RSPD="+ str( self.getParameter("Speed (%)") ) + "\ "
            sentence += "\VCT="+ str( self.getParameter("Voice shaping (%)") ) + "\ "
            sentence += textParam
            sentence +=  "\RST\ "
            id = self.tts.post.say(str(sentence), {"speakingMovementMode":movement})
            self.ids.append(id)
            self.tts.wait(id, 0)
        finally:
            try:
                self.ids.remove(id)
            except:
                pass
            if( self.ids == [] ):
                self.onStopped() # activate output of the box
                self.bIsRunning = False

    def onInput_onStop(self):
        self.onUnload()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="" id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" /><Parameter name="Voice shaping (%)" inherits_from_parent="1" content_type="1" value="100" default_value="100" min="50" max="150" tooltip="Changes the voice tone." id="5" /><Parameter name="Speed (%)" inherits_from_parent="1" content_type="1" value="95" default_value="100" min="50" max="200" tooltip="Changes the speed of the voice." id="6" /><Parameter name="Text" inherits_from_parent="0" content_type="5" value="Thank you so much for visiting us today! \pau=300\ It was a pleasure to be your host. \pau=300\ See you on your next mission. \pau=200\ ^start(animations/Stand/Gestures/Hey_1) Bye bye! ^wait(animations/Stand/Gestures/Hey_1)" default_value="" tooltip="The text you want to say. Don&apos;t forget to translate it!" id="7" /><Parameter name="Speaking movement mode" inherits_from_parent="0" content_type="3" value="contextual" default_value="contextual" custom_choice="0" tooltip="Body language during the speech." id="8"><Choice value="disabled" /><Choice value="random" /><Choice value="contextual" /></Parameter><Parameter name="Animation" inherits_from_parent="0" content_type="3" value="animations/Stand/Gestures/Hey_1" default_value="" custom_choice="1" tooltip="Animation played when Speaking movement mode is disabled." id="9" /></Box><Box name="Show Web View (goodbye)" id="18" localization="8" tooltip="UC05 - shows html/pages/&lt;Page&gt;?&lt;Query&gt; on the tablet." x="1930" y="140"><bitmap>media/images/box/internet/internet.png</bitmap><script language="4"><content><![CDATA[import time
try:
    from urllib import quote          # NAOqi (Python 2.7)
except ImportError:
    from urllib.parse import quote    # Python 3

class MyClass(GeneratedClass):
    """UC05 - Show a page of html/pages/ on the tablet.
    Parameters: "Page" (e.g. rating.html) and "Query" (e.g. outcome=none&kicker=Team photo).
    Values in Query may contain spaces: they are URL-encoded here."""

    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def _getTabletService(self):
        try:
            return self.session().service("ALTabletService")
        except Exception as e:
            self.logger.warning("ALTabletService not found: " + str(e))
            return None

    def _encodeQuery(self, query):
        parts = []
        for pair in query.split("&"):
            if not pair:
                continue
            if "=" in pair:
                k, v = pair.split("=", 1)
                parts.append(k + "=" + quote(v, safe=""))
            else:
                parts.append(pair)
        parts.append("t=%d" % int(time.time()))   # cache buster
        return "&".join(parts)

    def onInput_onStart(self):
        tabletService = self._getTabletService()
        appName = self.packageUid()
        if tabletService and appName:
            robotIP = "198.18.0.1"
            url = "http://{ip}/apps/{app}/pages/{page}?{query}".format(
                ip=robotIP, app=appName, page=self.getParameter("Page"),
                query=self._encodeQuery(self.getParameter("Query")))
            try:
                tabletService.cleanWebview()   # clear the old page and its cache
            except Exception as e:
                self.logger.warning(str(e))
            self.logger.info("Opening tablet URL: " + url)
            try:
                tabletService.showWebview(url)
            except Exception as e:
                self.logger.error("Tablet error: " + str(e))
        self.onStopped()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="3" /><Parameter name="Page" inherits_from_parent="0" content_type="3" value="goodbye.html" default_value="goodbye.html" custom_choice="0" tooltip="Page inside html/pages/" id="4" /><Parameter name="Query" inherits_from_parent="0" content_type="3" value="" default_value="" custom_choice="0" tooltip="URL parameters, e.g. pageHeading=Hello&amp;pageText=How are you" id="5" /></Box><Link inputowner="1" indexofinput="2" outputowner="0" indexofoutput="2" /><Link inputowner="2" indexofinput="2" outputowner="1" indexofoutput="4" /><Link inputowner="3" indexofinput="2" outputowner="1" indexofoutput="4" /><Link inputowner="4" indexofinput="2" outputowner="2" indexofoutput="4" /><Link inputowner="5" indexofinput="2" outputowner="4" indexofoutput="4" /><Link inputowner="6" indexofinput="2" outputowner="4" indexofoutput="5" /><Link inputowner="7" indexofinput="2" outputowner="4" indexofoutput="5" /><Link inputowner="8" indexofinput="2" outputowner="5" indexofoutput="4" /><Link inputowner="8" indexofinput="2" outputowner="6" indexofoutput="4" /><Link inputowner="10" indexofinput="2" outputowner="8" indexofoutput="4" /><Link inputowner="9" indexofinput="2" outputowner="8" indexofoutput="4" /><Link inputowner="11" indexofinput="2" outputowner="10" indexofoutput="5" /><Link inputowner="12" indexofinput="2" outputowner="10" indexofoutput="6" /><Link inputowner="12" indexofinput="2" outputowner="11" indexofoutput="4" /><Link inputowner="14" indexofinput="2" outputowner="12" indexofoutput="4" /><Link inputowner="13" indexofinput="2" outputowner="12" indexofoutput="4" /><Link inputowner="16" indexofinput="2" outputowner="14" indexofoutput="5" /><Link inputowner="16" indexofinput="3" outputowner="14" indexofoutput="6" /><Link inputowner="15" indexofinput="2" outputowner="14" indexofoutput="7" /><Link inputowner="17" indexofinput="2" outputowner="14" indexofoutput="4" /><Link inputowner="18" indexofinput="2" outputowner="14" indexofoutput="4" /><Link inputowner="0" indexofinput="4" outputowner="17" indexofoutput="4" /></Diagram></BehaviorKeyframe></BehaviorLayer></Timeline></Box></ChoregrapheProject>