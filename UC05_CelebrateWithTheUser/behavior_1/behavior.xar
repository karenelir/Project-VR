class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self, False)
        self.tts = ALProxy('ALAnimatedSpeech')
        self.ttsStop = ALProxy('ALAnimatedSpeech', True) #Create another proxy as wait is blocking if audioout is remote

    def onLoad(self):
        self.bIsRunning = False
        self.ids = []

    def onUnload(self):
        for id in self.ids:
            try:
                self.ttsStop.stop(id)
            except:
                pass
        while( self.bIsRunning ):
            time.sleep( 0.2 )

    def onInput_onStart(self):
        self.bIsRunning = True
        try:
            movement = self.getParameter("Speaking movement mode")
            textParam = self.getParameter("Text")
            if movement == "disabled":
                textParam = "^start({0}) {1} ^wait({0})".format(self.getParameter("Animation"), textParam)
            sentence = "\RSPD="+ str( self.getParameter("Speed (%)") ) + "\ "
            sentence += "\VCT="+ str( self.getParameter("Voice shaping (%)") ) + "\ "
            sentence += textParam
            sentence +=  "\RST\ "
            id = self.tts.post.say(str(sentence), {"speakingMovementMode":movement})
            self.ids.append(id)
            self.tts.wait(id, 0)
        finally:
            try:
                self.ids.remove(id)
            except:
                pass
            if( self.ids == [] ):
                self.onStopped() # activate output of the box
                self.bIsRunning = False

    def onInput_onStop(self):
        self.onUnload()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="" id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" /><Parameter name="Voice shaping (%)" inherits_from_parent="1" content_type="1" value="100" default_value="100" min="50" max="150" tooltip="Changes the voice tone." id="5" /><Parameter name="Speed (%)" inherits_from_parent="1" content_type="1" value="95" default_value="100" min="50" max="200" tooltip="Changes the speed of the voice." id="6" /><Parameter name="Text" inherits_from_parent="0" content_type="5" value="How about a team photo, to remember this moment? \pau=300\ Say yes or no, or tap my tablet." default_value="" tooltip="The text you want to say. Don&apos;t forget to translate it!" id="7" /><Parameter name="Speaking movement mode" inherits_from_parent="0" content_type="3" value="contextual" default_value="contextual" custom_choice="0" tooltip="Body language during the speech." id="8"><Choice value="disabled" /><Choice value="random" /><Choice value="contextual" /></Parameter><Parameter name="Animation" inherits_from_parent="0" content_type="3" value="animations/Stand/Gestures/Hey_1" default_value="" custom_choice="1" tooltip="Animation played when Speaking movement mode is disabled." id="9" /></Box><Box name="Show Web View (photo?)" id="9" localization="8" tooltip="UC05 - shows html/pages/&lt;Page&gt;?&lt;Query&gt; on the tablet." x="1080" y="220"><bitmap>media/images/box/internet/internet.png</bitmap><script language="4"><content><![CDATA[import time
try:
    from urllib import quote          # NAOqi (Python 2.7)
except ImportError:
    from urllib.parse import quote    # Python 3

class MyClass(GeneratedClass):
    """UC05 - Show a page of html/pages/ on the tablet.
    Parameters: "Page" (e.g. rating.html) and "Query" (e.g. outcome=none&kicker=Team photo).
    Values in Query may contain spaces: they are URL-encoded here."""

    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def _getTabletService(self):
        try:
            return self.session().service("ALTabletService")
        except Exception as e:
            self.logger.warning("ALTabletService not found: " + str(e))
            return None

    def _encodeQuery(self, query):
        parts = []
        for pair in query.split("&"):
            if not pair:
                continue
            if "=" in pair:
                k, v = pair.split("=", 1)
                parts.append(k + "=" + quote(v, safe=""))
            else:
                parts.append(pair)
        parts.append("t=%d" % int(time.time()))   # cache buster
        return "&".join(parts)

    def onInput_onStart(self):
        tabletService = self._getTabletService()
        appName = self.packageUid()
        if tabletService and appName:
            robotIP = "198.18.0.1"
            url = "http://{ip}/apps/{app}/pages/{page}?{query}".format(
                ip=robotIP, app=appName, page=self.getParameter("Page"),
                query=self._encodeQuery(self.getParameter("Query")))
            try:
                tabletService.cleanWebview()   # clear the old page and its cache
            except Exception as e:
                self.logger.warning(str(e))
            self.logger.info("Opening tablet URL: " + url)
            try:
                tabletService.showWebview(url)
            except Exception as e:
                self.logger.error("Tablet error: " + str(e))
        self.onStopped()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="3" /><Parameter name="Page" inherits_from_parent="0" content_type="3" value="confirmation.html" default_value="confirmation.html" custom_choice="0" tooltip="Page inside html/pages/" id="4" /><Parameter name="Query" inherits_from_parent="0" content_type="3" value="pageHeading=Team photo?&amp;pageText=Let's capture this moment together! Tap yes, or tell Pepper.&amp;pageImage=zerovr.png&amp;kicker=Team photo" default_value="pageHeading=Team photo?&amp;pageText=Let's capture this moment together! Tap yes, or tell Pepper.&amp;pageImage=zerovr.png&amp;kicker=Team photo" custom_choice="0" tooltip="URL parameters, e.g. pageHeading=Hello&amp;pageText=How are you" id="5" /></Box><Box name="photo_d" id="10" localization="8" tooltip="" x="1080" y="40"><dialogFile>../photo_d/photo_d.dlg</dialogFile><bitmap>media/images/box/box-dialog.png</bitmap><script language="4"><content><![CDATA[]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="" id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" /><Output name="photoAccepted" type="1" type_size="1" nature="2" inner="0" tooltip="" id="5" /><Output name="photoDeclined" type="1" type_size="1" nature="2" inner="0" tooltip="" id="6" /><Resource name="Speech" type="Lock" timeout="0" /><Resource name="Speech recognition" type="Lock" timeout="0" /></Box><Box name="Take Team Photo (step 4)" id="11" localization="8" tooltip="UC05 step 4 - countdown on the tablet, takes the team photo and displays it." x="1290" y="0"><bitmap>media/images/box/interaction/rec_movie.png</bitmap><script language="4"><content><![CDATA[import os, time
try:
    from urllib import quote
except ImportError:
    from urllib.parse import quote

class MyClass(GeneratedClass):
    """UC05 step 4: countdown + team photo.
    The countdown page (countdown.html) listens to the ALMemory event "photoCountdown" (3, 2, 1, 0).
    The picture is saved in html/pics/photos/ so the tablet can display it (photo.html).
    No camera (virtual robot / simulated prototype) -> the flow continues with a placeholder."""

    def __init__(self):
        GeneratedClass.__init__(self, False)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def _service(self, name):
        try:
            return self.session().service(name)
        except Exception as e:
            self.logger.warning("%s not available: %s" % (name, str(e)))
            return None

    def _packageRoot(self):
        try:
            root = os.path.dirname(self.behaviorAbsolutePath())
            if os.path.isdir(os.path.join(root, "html")):
                return root
        except Exception:
            pass
        return "/home/nao/.local/share/PackageManager/apps/" + self.packageUid()

    def _show(self, tablet, page, query):
        if not tablet:
            return
        url = "http://198.18.0.1/apps/%s/pages/%s?%st=%d" % (self.packageUid(), page, query, int(time.time()))
        try:
            self.logger.info("Opening tablet URL: " + url)
            tablet.showWebview(url)
        except Exception as e:
            self.logger.warning("Tablet error: " + str(e))

    def _say(self, tts, text):
        try:
            tts.say(text)
        except Exception:
            time.sleep(0.8)

    def _count(self, memory, n):
        try:
            memory.raiseEvent("photoCountdown", n)
        except Exception:
            pass

    def onInput_onStart(self):
        tablet = self._service("ALTabletService")
        memory = self._service("ALMemory")
        tts = self._service("ALTextToSpeech")
        leds = self._service("ALLeds")

        self._show(tablet, "countdown.html", "")
        time.sleep(1.0)        # let the page load and subscribe to the event
        self._say(tts, "Everyone squeeze in, and look right at my eyes!")
        for n, word in ((3, "Three!"), (2, "Two!"), (1, "One!")):
            self._count(memory, n)
            self._say(tts, word)
            time.sleep(0.35)
        try:
            tts.post.say("Say V R!")
        except Exception:
            pass
        time.sleep(0.6)

        # shutter
        photo = ""
        try:
            camera = self.session().service("ALPhotoCapture")
            folder = os.path.join(self._packageRoot(), "html", "pics", "photos")
            if not os.path.isdir(folder):
                os.makedirs(folder)
            name = "team_%d" % int(time.time())
            camera.setCameraID(int(self.getParameter("Camera (0=top, 1=bottom)")))
            camera.setResolution(int(self.getParameter("Resolution (1=QVGA, 2=VGA, 3=4VGA)")))
            camera.setPictureFormat("jpg")
            camera.takePicture(folder, name)
            photo = "photos/%s.jpg" % name
            self.logger.info("Team photo saved: " + os.path.join(folder, name + ".jpg"))
        except Exception as e:
            self.logger.warning("Camera not available, photo simulated: " + str(e))
        self._count(memory, 0)
        try:
            leds.fadeRGB("FaceLeds", 0xFFFFFF, 0.05)
        except Exception:
            pass

        game = ""
        try:
            game = str(memory.getData("UC05/LastGame"))
        except Exception:
            pass
        self._show(tablet, "photo.html", "photo=%s&game=%s&" % (quote(photo, safe="/"), quote(game, safe="")))
        if photo:
            self._say(tts, "Got it! You all look like champions.")
        else:
            self._say(tts, "Click! You all look like champions.")
        self.onStopped()

    def onInput_onStop(self):
        self.onUnload()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="" id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" /><Parameter name="Camera (0=top, 1=bottom)" inherits_from_parent="0" content_type="1" value="0" default_value="0" min="0" max="1" tooltip="Camera used for the photo." id="5" /><Parameter name="Resolution (1=QVGA, 2=VGA, 3=4VGA)" inherits_from_parent="0" content_type="1" value="2" default_value="2" min="1" max="3" tooltip="ALPhotoCapture resolution." id="6" /></Box><Box name="Ask Rating (step 5)" id="12" localization="8" tooltip="Say some text with animations. The text can be localized." x="1500" y="40"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import time

