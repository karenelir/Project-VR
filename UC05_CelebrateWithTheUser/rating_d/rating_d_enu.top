topic: ~rating_d()
language: enu

# UC05 - Steps 5 and 6: the group rates the experience from 1 to 10, by voice or on rating.html.
# The question is asked by the "Ask Rating" Say box; this topic listens for the answer.
#   1-4  -> lowRating  (6b: brief, non-defensive follow-up question asking for improvement ideas)
#   5-6  -> okRating   (6a: brief positive acknowledgment)
#   7-10 -> highRating (6a: brief positive acknowledgment)
# Outputs of the dialog box:
#   $rating       (number) -> Save Rating box
#   $feedback     (string) -> Save Rating box (only after a low rating)
#   $showImprove  (bang)   -> opens improve.html on the tablet
#   $onStopped             -> Farewell (step 7)

concept:(ratePrefix) ["I give it" "I'd give it" "I would give it" "I give you" "I'd give you" "I rate it" "I'd rate it" "I would say" "I'd say" "I say" "we give it" "we'd give it" "we give you" "we say" "it's a" "it was a" "that's a" maybe definitely "a solid"]
concept:(declineRating) [no nope "no thanks" "no thank you" "not now" "maybe later" "skip it" skip "I'd rather not" "I prefer not to" "we're good" "not today"]

# ---------- Step 6: Pepper responds to the rating ----------
proposal: %highRating ^start(animations/Stand/Gestures/Enthusiastic_4) Wow, thank you so much! That really makes my day. ^wait(animations/Stand/Gestures/Enthusiastic_4) $onStopped=1

proposal: %okRating Thank you for your honest rating! We will keep working to make your next visit even better. $onStopped=1

# 6b: low rating -> one short, non-defensive follow-up question. Pepper never argues with the score.
proposal: %lowRating Thank you for being honest with me. \pau=300\ What is one thing we could do better next time? You can tell me, or tap an idea on my tablet. $showImprove=1
    u1:(e:improvementGiven) $feedback=$improvementGiven Thank you, that is really helpful. I will pass it on to the team. $onStopped=1
    u1:(e:improvementSkipped) That's okay. Thank you for your rating anyway. $onStopped=1
    u1:([wait waiting queue line "the line" "the wait" "took too long" "too long"]) $feedback=wait_time Thank you, I will tell the team to keep the wait shorter. $onStopped=1
    u1:([headset headsets equipment glasses "the gear" "the vest" uncomfortable heavy comfort]) $feedback=equipment_comfort Thank you, I will let the team know about the equipment. $onStopped=1
    u1:([game games "the game" "the story" "the mission" boring "too hard" "too easy" "too scary" difficulty]) $feedback=game_choice Thank you, I will share that with the team so they can improve the games. $onStopped=1
    u1:([staff "the staff" help instructions explanation "the rules"]) $feedback=staff_help Thank you, I will pass that on to our staff. $onStopped=1
    u1:([price prices expensive cost money]) $feedback=price Thank you, I will pass that on to the team. $onStopped=1
    u1:([nothing no "not really" "no idea" "I don't know" "nothing really"]) That's okay. Thank you for your rating anyway. $onStopped=1
    u1:(e:Dialog/NotUnderstood) $feedback=$Dialog/LastInput Thank you, I will share your idea with the team. $onStopped=1
    u1:(e:Dialog/NotSpeaking15) No worries. Thank you for your rating anyway. $onStopped=1

# ---------- Step 5: the rating itself ----------
# Voice: "seven", "I give it seven", "eight out of ten", ...
u:({~ratePrefix} [one "a one"] {"out of ten" "out of 10"}) $rating=1 ^gotoReactivate(lowRating)
u:({~ratePrefix} [two "a two"] {"out of ten" "out of 10"}) $rating=2 ^gotoReactivate(lowRating)
u:({~ratePrefix} [three "a three"] {"out of ten" "out of 10"}) $rating=3 ^gotoReactivate(lowRating)
u:({~ratePrefix} [four "a four"] {"out of ten" "out of 10"}) $rating=4 ^gotoReactivate(lowRating)
u:({~ratePrefix} [five "a five"] {"out of ten" "out of 10"}) $rating=5 ^gotoReactivate(okRating)
u:({~ratePrefix} [six "a six"] {"out of ten" "out of 10"}) $rating=6 ^gotoReactivate(okRating)
u:({~ratePrefix} [seven "a seven"] {"out of ten" "out of 10"}) $rating=7 ^gotoReactivate(highRating)
u:({~ratePrefix} [eight "an eight"] {"out of ten" "out of 10"}) $rating=8 ^gotoReactivate(highRating)
u:({~ratePrefix} [nine "a nine"] {"out of ten" "out of 10"}) $rating=9 ^gotoReactivate(highRating)
u:({~ratePrefix} [ten "a ten"] {"out of ten" "out of 10"}) $rating=10 ^gotoReactivate(highRating)

# Tablet: rating.html raises ONE of these events, with the number 1-10 as its value
u:(e:ratingHigh) $rating=$ratingHigh ^gotoReactivate(highRating)
u:(e:ratingOk) $rating=$ratingOk ^gotoReactivate(okRating)
u:(e:ratingLow) $rating=$ratingLow ^gotoReactivate(lowRating)

# Not sure what to say: explain the scale once more
u:(["I don't know" "I'm not sure" "not sure" "how does it work" "what do you mean" "what scale"]) No pressure! \pau=200\ Ten means amazing, and one means not great. \pau=300\ Just say a number, or say no thanks to skip.

# ---------- Extension 5a: the group declines to rate -> thank them anyway, go to step 7 ----------
u:(~declineRating) No problem at all! Thank you anyway. $onStopped=1
u:(e:ratingDeclined) No problem at all! Thank you anyway. $onStopped=1
