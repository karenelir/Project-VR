topic: ~photo_d()
language: enu

# UC05 - Steps 3 and 4: Pepper invites the group to take a team photo.
# The question itself is asked by the "Ask Photo" Say box; this topic only listens for the answer,
# by voice or by the Yes / No buttons on confirmation.html (events yesAnswer / noAnswer).

concept:(photoYes) [yes yeah yep sure okay "yes please" "of course" "let's do it" "let's go" "why not" cheese "take it" "take the photo" "take a photo"]
concept:(photoNo) [no nope "no thanks" "no thank you" "not now" "maybe later" "skip it" skip "we're good" "not today"]

proposal: %photoAccepted ^start(animations/Stand/Gestures/Enthusiastic_4) Awesome! Get ready, team! ^wait(animations/Stand/Gestures/Enthusiastic_4) $photoAccepted=1 $onStopped=1

# Extension 3a: the group declines. Pepper skips the photo and does NOT repeat the invitation.
proposal: %photoDeclined No problem at all! $photoDeclined=1 $onStopped=1

u:(~photoYes) ^gotoReactivate(photoAccepted)
u:(~photoNo) ^gotoReactivate(photoDeclined)

u:(e:yesAnswer) ^gotoReactivate(photoAccepted)
u:(e:noAnswer) ^gotoReactivate(photoDeclined)
