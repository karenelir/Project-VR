try:
    from urllib import quote          # NAOqi (Python 2.7)
except ImportError:
    from urllib.parse import quote    # Python 3

class MyClass(GeneratedClass):
    """UC01 - Show a page of html/pages/ on the tablet.
    Parameters: "Page" (e.g. rating.html) and "Query" (e.g. outcome=none&kicker=Team photo).
    Values in Query may contain spaces: they are URL-encoded here."""

    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def _getTabletService(self):
        try:
            return self.session().service("ALTabletService")
        except Exception as e:
            self.logger.warning("ALTabletService not found: " + str(e))
            return None

    def _encodeQuery(self, query):
        parts = []
        for pair in query.split("&"):
            if not pair:
                continue
            if "=" in pair:
                k, v = pair.split("=", 1)
                parts.append(k + "=" + quote(v, safe=""))
            else:
                parts.append(pair)
        parts.append("t=%d" % int(time.time()))   # cache buster
        return "&".join(parts)

    def onInput_onStart(self):
        tabletService = self._getTabletService()
        appName = self.packageUid()
        if tabletService and appName:
            robotIP = "198.18.0.1"
            url = "http://{ip}/apps/{app}/pages/{page}?{query}".format(
                ip=robotIP, app=appName, page=self.getParameter("Page"),
                query=self._encodeQuery(self.getParameter("Query")))
            try:
                tabletService.cleanWebview()   # clear the old page and its cache
            except Exception as e:
                self.logger.warning(str(e))
            self.logger.info("Opening tablet URL: " + url)
            try:
                tabletService.showWebview(url)
            except Exception as e:
                self.logger.error("Tablet error: " + str(e))
        self.onStopped()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="3" /><Parameter name="Page" inherits_from_parent="0" content_type="3" value="visitor.html" default_value="visitor.html" custom_choice="0" tooltip="Page inside html/pages/" id="4" /><Parameter name="Query" inherits_from_parent="0" content_type="3" value="hint=1" default_value="hint=1" custom_choice="0" tooltip="URL parameters, e.g. pageHeading=Hello&amp;pageText=How are you" id="5" /></Box><Box name="Save Visitor Status" id="11" localization="8" tooltip="UC01 - stores UC01/VisitorStatus and routes to 5a / 5b." x="1120" y="40"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[import time

class MyClass(GeneratedClass):
    """UC01 POSTCOND-1: store the visitor status and route the flow (step 5).
    Input (string): new | returning | mixed     (mixed = group with conflicting answers)
    ALMemory: UC01/VisitorStatus, UC01/LastVisitTime (read later by UC-02 Check In)."""

    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def onInput_onStart(self, status):
        status = str(status).strip().lower()
        if status not in ("new", "returning", "mixed"):
            status = "new"            # safest default: the longer introduction
        try:
            memory = self.session().service("ALMemory")
            memory.insertData("UC01/VisitorStatus", status)
            memory.insertData("UC01/LastVisitTime", time.strftime("%Y-%m-%d %H:%M:%S"))
        except Exception as e:
            self.logger.warning("ALMemory: " + str(e))
        self.logger.info("Visitor status: " + status)
        if status == "returning":
            self.returningVisitor()
        elif status == "mixed":
            self.mixedGroup()
        else:
            self.newVisitor()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="3" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Output name="newVisitor" type="1" type_size="1" nature="2" inner="0" tooltip="" id="3" /><Output name="returningVisitor" type="1" type_size="1" nature="2" inner="0" tooltip="" id="4" /><Output name="mixedGroup" type="1" type_size="1" nature="2" inner="0" tooltip="" id="5" /></Box><Box name="Mixed Group Welcome (open issue)" id="12" localization="8" tooltip="Say some text with animations. The text can be localized." x="1340" y="160"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import time

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self, False)
        self.tts = ALProxy('ALAnimatedSpeech')
        self.ttsStop = ALProxy('ALAnimatedSpeech', True) #Create another proxy as wait is blocking if audioout is remote

    def onLoad(self):
        self.bIsRunning = False
        self.ids = []

    def onUnload(self):
        for id in self.ids:
            try:
                self.ttsStop.stop(id)
            except:
                pass
        while( self.bIsRunning ):
            time.sleep( 0.2 )

    def onInput_onStart(self):
        self.bIsRunning = True
        try:
            movement = self.getParameter("Speaking movement mode")
            textParam = self.getParameter("Text")
            if movement == "disabled":
                textParam = "^start({0}) {1} ^wait({0})".format(self.getParameter("Animation"), textParam)
            sentence = "\RSPD="+ str( self.getParameter("Speed (%)") ) + "\ "
            sentence += "\VCT="+ str( self.getParameter("Voice shaping (%)") ) + "\ "
            sentence += textParam
            sentence +=  "\RST\ "
            id = self.tts.post.say(str(sentence), {"speakingMovementMode":movement})
            self.ids.append(id)
            self.tts.wait(id, 0)
        finally:
            try:
                self.ids.remove(id)
            except:
                pass
            if( self.ids == [] ):
                self.onStopped() # activate output of the box
                self.bIsRunning = False

    def onInput_onStop(self):
        self.onUnload()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="" id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" /><Parameter name="Voice shaping (%)" inherits_from_parent="1" content_type="1" value="100" default_value="100" min="50" max="150" tooltip="Changes the voice tone." id="5" /><Parameter name="Speed (%)" inherits_from_parent="1" content_type="1" value="95" default_value="100" min="50" max="200" tooltip="Changes the speed of the voice." id="6" /><Parameter name="Text" inherits_from_parent="0" content_type="5" value="Welcome back to those of you who have been here before, \pau=200\ and a big welcome to our first timers! \pau=300\ Let me quickly explain how it works, so everyone is ready." default_value="" tooltip="The text you want to say. Don&apos;t forget to translate it!" id="7" /><Parameter name="Speaking movement mode" inherits_from_parent="0" content_type="3" value="contextual" default_value="contextual" custom_choice="0" tooltip="Body language during the speech." id="8"><Choice value="disabled" /><Choice value="random" /><Choice value="contextual" /></Parameter><Parameter name="Animation" inherits_from_parent="0" content_type="3" value="animations/Stand/Gestures/Hey_1" default_value="" custom_choice="1" tooltip="Animation played when Speaking movement mode is disabled." id="9" /></Box><Box name="New Customer Intro (5a)" id="13" localization="8" tooltip="Say some text with animations. The text can be localized." x="1560" y="0"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import time

