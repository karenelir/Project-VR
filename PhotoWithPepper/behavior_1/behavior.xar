<?xml version="1.0" encoding="UTF-8" ?><ChoregrapheProject xmlns="http://www.aldebaran-robotics.com/schema/choregraphe/project.xsd" xar_version="3"><Box name="root" id="-1" localization="8" tooltip="Root box of Choregraphe&apos;s behavior. Highest level possible." x="0" y="0"><bitmap>media/images/box/root.png</bitmap><script language="4"><content><![CDATA[]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /><Timeline enable="0"><BehaviorLayer name="behavior_layer1"><BehaviorKeyframe name="keyframe1" index="1"><Diagram scale="100"><Box name="Init" id="1" localization="8" tooltip="Stand, Christmas eyes, short Jingle Bells." x="40" y="60"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):
    """UC05 - Init: stand up, neutral white eyes. Basic awareness is kept ON so Pepper keeps
    looking at the group while celebrating."""

    def __init__(self):
        GeneratedClass.__init__(self, False)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def onInput_onStart(self):
        try:
            posture = ALProxy("ALRobotPosture")
            posture.setMaxTryNumber(3)
            posture.goToPosture("Stand", 0.8)
        except Exception as e:
            self.logger.warning("Posture not available: " + str(e))
        try:
            leds = ALProxy("ALLeds")
            leds.fadeRGB("LeftFaceLeds", 0xFF2030, 0.3)      # Christmas eyes: one red, one green
            leds.fadeRGB("RightFaceLeds", 0x20FF50, 0.3)
        except Exception as e:
            self.logger.warning("LEDs not available: " + str(e))
        try:
            import os
            root = os.path.dirname(self.behaviorAbsolutePath())
            if not os.path.isdir(os.path.join(root, "sounds")):
                root = "/home/nao/.local/share/PackageManager/apps/" + self.packageUid()
            ALProxy("ALAudioPlayer").post.playFile(os.path.join(root, "sounds", "jingle_short.ogg"), 0.45, 0.0)
        except Exception as e:
            self.logger.warning("Jingle: " + str(e))
        self.onStopped()

    def onInput_onStop(self):
        self.onUnload()
        self.onStopped()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="" id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" /></Box><Box name="Ask: Christmas photo?" id="2" localization="8" tooltip="Reusable 'Ask on Tablet' box: shows a page, Pepper asks, the first tap or spoken answer fires the matching output." x="240" y="60"><bitmap>media/images/box/box-dialog.png</bitmap><script language="4"><content><![CDATA[import os, time
import re as _re
_BS = chr(92)
def _pauses(text):
    # half-second pause after every sentence, so long lines are easy to follow
    text = _re.sub(r"([.!?])\s+" + _re.escape(_BS) + r"pau=[1-4]\d\d" + _re.escape(_BS),
                   lambda m: m.group(1) + " " + _BS + "pau=500" + _BS, text)
    return _re.sub(r"([.!?])\s+(?!" + _re.escape(_BS) + r"pau)(?=[A-Z^])",
                   lambda m: m.group(1) + " " + _BS + "pau=500" + _BS + " ", text)

def _waitForPage(session, page, timeout=2.5):
    # Wait until the tablet reports (event pageReady) that this page is really on the screen,
    # so Pepper never talks over the previous screen. Gives up after `timeout` seconds.
    import time as _t
    state = {"ready": False}
    def cb(value):
        if str(value).split("?")[0] == page:
            state["ready"] = True
    sub = link = None
    try:
        sub = session.service("ALMemory").subscriber("pageReady")
        link = sub.signal.connect(cb)
    except Exception:
        return None
    return (sub, link, state, _t.time() + timeout)

def _finishWait(handle):
    import time as _t
    if handle is None:
        return
    sub, link, state, end = handle
    while not state["ready"] and _t.time() < end:
        _t.sleep(0.05)
    try:
        sub.signal.disconnect(link)
    except Exception:
        pass
    _t.sleep(0.3)          # let the page settle before talking

class MyClass(GeneratedClass):
    # Reusable "Ask on Tablet" box.
    #   Page / Query : page of html/pages/ to show (shown FIRST, so a tap works straight away)
    #   Say          : what Pepper says (can be interrupted by a tap)
    #   Taps         : tablet event -> output        e.g.  yesAnswer=yes; noAnswer=no
    #   Words        : spoken words -> output        e.g.  yes,sure,okay=yes; no,no thanks=no
    #   Replies      : output -> short answer        e.g.  yes=Awesome!; no=No problem!
    #   Sound        : optional file in sounds/ played when the box starts
    #   If nobody answers (s) / Timeout output : what happens when nobody taps or speaks
    # The box then fires the output with that name. Every tap is kept, even one made while Pepper talks.

    def __init__(self):
        GeneratedClass.__init__(self, False)

    def onLoad(self):
        self.answer = None
        self.stopped = False
        self.links = []
        self.asrOn = False
        self.asrName = "AskOnTablet_%d" % id(self)

    def onUnload(self):
        self.stopped = True
        self._cleanup()

    def _pairs(self, text):
        result = []
        for part in str(text).split(";"):
            if "=" in part:
                left, right = part.split("=", 1)
                result.append((left.strip(), right.strip()))
        return result

    def _tap(self, output):
        def cb(value):
            if self.answer is None:
                self.answer = output
        return cb

    def _word(self, value):
        try:
            word, conf = str(value[0]), float(value[1])
        except Exception:
            return
        if self.answer is None and conf >= float(self.getParameter("Voice confidence (0-1)")) and word in self.words:
            self.answer = self.words[word]

    def _cleanup(self):
        for (sub, link) in self.links:
            try:
                sub.signal.disconnect(link)
            except Exception:
                pass
        self.links = []
        if self.asrOn:
            try:
                ALProxy("ALSpeechRecognition").unsubscribe(self.asrName)
            except Exception:
                pass
            self.asrOn = False

    def _root(self):
        root = os.path.dirname(self.behaviorAbsolutePath())
        if os.path.isdir(os.path.join(root, "sounds")):
            return root
        return "/home/nao/.local/share/PackageManager/apps/" + self.packageUid()

    def onInput_onStart(self):
        self.answer = None
        self.stopped = False
        self.words = {}
        for (words, output) in self._pairs(self.getParameter("Words")):
            for w in words.split(","):
                if w.strip():
                    self.words[w.strip()] = output
        replies = dict(self._pairs(self.getParameter("Replies")))

        memory = self.session().service("ALMemory")
        for (event, output) in self._pairs(self.getParameter("Taps")):
            try:
                sub = memory.subscriber(event)
                self.links.append((sub, sub.signal.connect(self._tap(output))))
            except Exception as e:
                self.logger.warning("Cannot subscribe to %s: %s" % (event, str(e)))
        hasTablet = True
        waiting = _waitForPage(self.session(), self.getParameter("Page"))
        try:
            tablet = self.session().service("ALTabletService")
            query = self.getParameter("Query")
            tablet.showWebview("http://198.18.0.1/apps/%s/pages/%s?%s%st=%d" % (
                self.packageUid(), self.getParameter("Page"), query, "&" if query else "", int(time.time())))
        except Exception as e:
            hasTablet = False
            waiting = None
            self.logger.warning("No tablet: " + str(e))
        _finishWait(waiting)                 # Pepper only talks once the page is on the screen

        sound = str(self.getParameter("Sound")).strip()
        if sound:
            try:
                ALProxy("ALAudioPlayer").post.playFile(os.path.join(self._root(), "sounds", sound), 0.45, 0.0)
            except Exception as e:
                self.logger.warning("Sound: " + str(e))
        speech = speechId = None
        try:
            speech = ALProxy("ALAnimatedSpeech")
            speechId = speech.post.say(_pauses(self.getParameter("Say")), {"bodyLanguageMode": "contextual"})
        except Exception as e:
            self.logger.warning("Speech: " + str(e))
        # While Pepper talks only taps count: the microphone must not hear Pepper's own "yes or no".
        while speechId is not None and self.answer is None and not self.stopped:
            try:
                if not speech.isRunning(speechId):
                    break
            except Exception:
                break
            time.sleep(0.05)
        if self.words and self.answer is None and not self.stopped:
            try:
                asr = ALProxy("ALSpeechRecognition")
                try:
                    asr.pause(True)
                except Exception:
                    pass
                asr.setLanguage("English")
                asr.setVocabulary(list(self.words.keys()), False)
                try:
                    asr.pause(False)
                except Exception:
                    pass
                sub = memory.subscriber("WordRecognized")
                self.links.append((sub, sub.signal.connect(self._word)))
                asr.subscribe(self.asrName)
                self.asrOn = True
            except Exception as e:
                self.logger.warning("Voice not available, tablet only: " + str(e))

        wait = int(self.getParameter("If nobody answers (s)"))
        if not hasTablet:
            wait = min(wait, 5)       # virtual robot: nobody can tap, use the timeout output quickly
        end = time.time() + wait
        while self.answer is None and not self.stopped and time.time() < end:
            time.sleep(0.05)
        self._cleanup()
        cut = False
        try:
            if speechId is not None and speech.isRunning(speechId):
                cut = True
        except Exception:
            pass
        try:
            ALProxy("ALTextToSpeech").stopAll()      # a tap cuts Pepper's sentence
        except Exception:
            pass
        if cut:
            try:
                ALProxy("ALRobotPosture").goToPosture("Stand", 0.6)   # arms back down if a gesture was cut
            except Exception:
                pass
        if self.stopped:
            return
        answer = self.answer or self.getParameter("Timeout output")
        self.logger.info("%s -> %s" % (self.getParameter("Page"), answer))
        if self.answer is not None and sound:
            try:
                ALProxy("ALAudioPlayer").stopAll()      # someone answered: stop the music
            except Exception:
                pass
        if answer in replies and replies[answer]:
            try:
                ALProxy("ALAnimatedSpeech").say(_pauses(replies[answer]), {"bodyLanguageMode": "contextual"})
            except Exception:
                pass
        getattr(self, answer)()

    def onInput_onStop(self):
        self.stopped = True]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="" id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="" id="3" /><Output name="yes" type="1" type_size="1" nature="2" inner="0" tooltip="" id="4" /><Output name="no" type="1" type_size="1" nature="2" inner="0" tooltip="" id="5" /><Output name="tablet" type="1" type_size="1" nature="2" inner="0" tooltip="" id="6" /><Output name="selfie" type="1" type_size="1" nature="2" inner="0" tooltip="" id="7" /><Parameter name="Page" inherits_from_parent="0" content_type="3" value="photoask.html" default_value="photoask.html" custom_choice="0" tooltip="Page in html/pages/." id="8" /><Parameter name="Query" inherits_from_parent="0" content_type="3" value="" default_value="" custom_choice="0" tooltip="URL parameters for the page." id="9" /><Parameter name="Say" inherits_from_parent="0" content_type="3" value="Choose yes or no! Do you want a Christmas photo with me? Tap a big button on my tablet, or just tell me. Ho ho ho!" default_value="Choose yes or no! Do you want a Christmas photo with me? Tap a big button on my tablet, or just tell me. Ho ho ho!" custom_choice="0" tooltip="What Pepper says (a tap interrupts it)." id="10" /><Parameter name="Taps" inherits_from_parent="0" content_type="3" value="yesAnswer=yes; noAnswer=no" default_value="yesAnswer=yes; noAnswer=no" custom_choice="0" tooltip="tablet event=output; ..." id="11" /><Parameter name="Words" inherits_from_parent="0" content_type="3" value="yes,yeah,sure,okay,yes please,of course,let's do it=yes; no,nope,no thanks,not now,maybe later=no; selfie,a selfie,pose,strike a pose=selfie; you take it,take it yourself,you take the photo=tablet" default_value="yes,yeah,sure,okay,yes please,of course,let's do it=yes; no,nope,no thanks,not now,maybe later=no; selfie,a selfie,pose,strike a pose=selfie; you take it,take it yourself,you take the photo=tablet" custom_choice="0" tooltip="word,word=output; ...  (spoken answers)" id="12" /><Parameter name="Replies" inherits_from_parent="0" content_type="3" value="yes=Ho ho ho, awesome!; no=No problem at all! Merry Christmas anyway!; selfie=Oh yes, Christmas selfie time!; tablet=Great, I will be Santa's photographer!" default_value="yes=Ho ho ho, awesome!; no=No problem at all! Merry Christmas anyway!; selfie=Oh yes, Christmas selfie time!; tablet=Great, I will be Santa's photographer!" custom_choice="0" tooltip="output=what Pepper answers; ..." id="13" /><Parameter name="Sound" inherits_from_parent="0" content_type="3" value="" default_value="" custom_choice="0" tooltip="Optional sound file in sounds/ played at the start." id="14" /><Parameter name="If nobody answers (s)" inherits_from_parent="0" content_type="1" value="120" default_value="120" min="5" max="900" tooltip="Wait this long for a tap or a spoken answer (5 s on the virtual robot)." id="15" /><Parameter name="Timeout output" inherits_from_parent="0" content_type="3" value="no" default_value="no" custom_choice="0" tooltip="Output used when nobody answers." id="16" /><Parameter name="Voice confidence (0-1)" inherits_from_parent="0" content_type="2" value="0.4" default_value="0.4" min="0" max="1" tooltip="Minimum speech recognition confidence." id="17" /></Box><Box name="Ask: Who takes the photo?" id="3" localization="8" tooltip="Reusable 'Ask on Tablet' box: shows a page, Pepper asks, the first tap or spoken answer fires the matching output." x="460" y="60"><bitmap>media/images/box/box-dialog.png</bitmap><script language="4"><content><![CDATA[import os, time
import re as _re
_BS = chr(92)
